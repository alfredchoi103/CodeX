    "manifest": {"type": "object", "additionalProperties": false, "required": ["ontologyId", "ontologyVersion", "specVersion", "namespace", "status", "owners", "documents", "contentDigest"], "properties": {"ontologyId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"}, "ontologyVersion": {"$ref": "#/$defs/coreSemver"}, "specVersion": {"$ref": "#/$defs/semver"}, "namespace": {"type": "string", "format": "uri"}, "status": {"$ref": "#/$defs/lifecycle"}, "owners": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["role", "name"], "properties": {"role": {"type": "string", "minLength": 1}, "name": {"type": "string", "minLength": 1}}}}, "documents": {"type": "object", "additionalProperties": false, "required": ["semantics", "kinetics", "bindings", "policies", "evidence", "migrations", "traceability"], "properties": {"semantics": {"const": "semantics.yaml"}, "kinetics": {"const": "kinetics.yaml"}, "bindings": {"const": "bindings.yaml"}, "policies": {"const": "policies.yaml"}, "evidence": {"const": "evidence.yaml"}, "migrations": {"const": "migrations.yaml"}, "traceability": {"const": "traceability.yaml"}}}, "contentDigest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}}},
