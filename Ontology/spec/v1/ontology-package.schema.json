{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/spec/v1/ontology-package.schema.json",
  "title": "Executable Business Ontology Package",
  "x-traceability-profile": {
    "version": "1.0",
    "collections": [
      {"document": "semantics", "path": "objectTypes", "definition": "objectType", "nested": [{"path": "properties", "definition": "property"}]},
      {"document": "semantics", "path": "links", "definition": "linkType"},
      {"document": "semantics", "path": "interfaces", "definition": "interface"},
      {"document": "semantics", "path": "invariants", "definition": "rule"},
      {"document": "semantics", "path": "businessTerms", "definition": "businessTerm"},
      {"document": "kinetics", "path": "actions", "definition": "action"},
      {"document": "kinetics", "path": "queries", "definition": "query"},
      {"document": "kinetics", "path": "stateMachines", "definition": "stateMachine", "nested": [{"path": "states", "definition": "state"}, {"path": "transitions", "definition": "transition"}]},
      {"document": "kinetics", "path": "domainEvents", "definition": "domainEvent"}
    ]
  },
  "x-rdf-projection-profile": {
    "version": "1.0",
    "collections": [
      {"document": "semantics", "path": "objectTypes", "definition": "objectType", "rdfClass": "ObjectType", "nested": [{"path": "properties", "definition": "property", "rdfClass": "PropertyType"}]},
      {"document": "semantics", "path": "links", "definition": "linkType", "rdfClass": "LinkType"},
      {"document": "semantics", "path": "interfaces", "definition": "interface", "rdfClass": "InterfaceType"},
      {"document": "semantics", "path": "invariants", "definition": "rule", "rdfClass": "Invariant"},
      {"document": "semantics", "path": "businessTerms", "definition": "businessTerm", "rdfClass": "BusinessTerm"},
      {"document": "kinetics", "path": "actions", "definition": "action", "rdfClass": "ActionType"},
      {"document": "kinetics", "path": "queries", "definition": "query", "rdfClass": "QueryType"},
      {"document": "kinetics", "path": "stateMachines", "definition": "stateMachine", "rdfClass": "StateMachine"},
      {"document": "kinetics", "path": "domainEvents", "definition": "domainEvent", "rdfClass": "DomainEventType"}
    ]
  },
  "oneOf": [
    {"$ref": "#/$defs/manifest"}, {"$ref": "#/$defs/semantics"},
    {"$ref": "#/$defs/kinetics"}, {"$ref": "#/$defs/bindings"},
    {"$ref": "#/$defs/policies"}, {"$ref": "#/$defs/evidence"},
    {"$ref": "#/$defs/migrations"}, {"$ref": "#/$defs/traceability"},
    {"$ref": "#/$defs/adjudicationDocument"}
  ],
  "$defs": {
    "stableId": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]*$"},
    "internalStableId": {"type": "string", "pattern": "^(?:[A-Za-z][A-Za-z0-9._-]*|domain:[A-Za-z][A-Za-z0-9._-]*)$"},
    "reference": {"anyOf": [{"$ref": "#/$defs/stableId"}, {"type": "string", "format": "uri", "pattern": "^(?:[A-Za-z][A-Za-z0-9+.-]*://|external:).+$"}]},
    "label": {"type": "string", "minLength": 1},
    "descriptions": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}, "propertyNames": {"pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]+)*$"}},
    "lifecycle": {"enum": ["hypothesis", "proposed", "accepted", "deprecated", "retracted"]},
    "idRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "nonEmptyIdRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "stableIdList": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/stableId"}},
    "stringList": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "valueType": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "primitive"], "properties": {"kind": {"const": "primitive"}, "primitive": {"enum": ["string", "integer", "number", "boolean", "date", "dateTime", "uri"]}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "values"], "properties": {"kind": {"const": "enum"}, "values": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": ["string", "number", "integer", "boolean"]}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "fields"], "properties": {"kind": {"const": "struct"}, "fields": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "valueType"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "valueType": {"$ref": "#/$defs/valueType"}, "required": {"type": "boolean"}}}}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "targetRef"], "properties": {"kind": {"const": "reference"}, "targetRef": {"$ref": "#/$defs/stableId"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "base"], "properties": {"kind": {"const": "temporal"}, "base": {"enum": ["date", "dateTime"]}, "timezone": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "geometry"], "properties": {"kind": {"const": "spatial"}, "geometry": {"enum": ["point", "line", "polygon", "geometry"]}, "crs": {"type": "string"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "numericType", "unit"], "properties": {"kind": {"const": "measured"}, "numericType": {"enum": ["integer", "number"]}, "unit": {"type": "string", "minLength": 1}}}
      ]
    },
    "property": {"type": "object", "additionalProperties": false, "required": ["id", "label", "valueType"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "descriptions": {"$ref": "#/$defs/descriptions"}, "status": {"$ref": "#/$defs/lifecycle"}, "evidenceRefs": {"$ref": "#/$defs/idRefs"}, "valueType": {"$ref": "#/$defs/valueType"}, "required": {"type": "boolean"}, "default": {}}},
    "objectType": {"type": "object", "additionalProperties": false, "required": ["id", "label", "key", "properties"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "descriptions": {"$ref": "#/$defs/descriptions"}, "status": {"$ref": "#/$defs/lifecycle"}, "evidenceRefs": {"$ref": "#/$defs/idRefs"}, "key": {"$ref": "#/$defs/stableIdList"}, "properties": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/property"}}}},
    "linkType": {"type": "object", "additionalProperties": false, "required": ["id", "label", "sourceRef", "targetRef", "cardinality"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "descriptions": {"$ref": "#/$defs/descriptions"}, "status": {"$ref": "#/$defs/lifecycle"}, "evidenceRefs": {"$ref": "#/$defs/idRefs"}, "sourceRef": {"$ref": "#/$defs/stableId"}, "targetRef": {"$ref": "#/$defs/stableId"}, "cardinality": {"enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"]}}},
    "interface": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "descriptions": {"$ref": "#/$defs/descriptions"}, "status": {"$ref": "#/$defs/lifecycle"}, "evidenceRefs": {"$ref": "#/$defs/idRefs"}, "propertyRefs": {"$ref": "#/$defs/idRefs"}, "actionRefs": {"$ref": "#/$defs/idRefs"}}},
    "rule": {"type": "object", "additionalProperties": false, "required": ["id", "label", "expression"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "descriptions": {"$ref": "#/$defs/descriptions"}, "status": {"$ref": "#/$defs/lifecycle"}, "evidenceRefs": {"$ref": "#/$defs/idRefs"}, "expression": {"type": "string", "minLength": 1}}},
    "businessTerm": {"type": "object", "additionalProperties": false, "required": ["id", "label", "definition"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "descriptions": {"$ref": "#/$defs/descriptions"}, "status": {"$ref": "#/$defs/lifecycle"}, "evidenceRefs": {"$ref": "#/$defs/idRefs"}, "definition": {"type": "string", "minLength": 1}, "synonyms": {"$ref": "#/$defs/stringList"}}},
    "semantics": {"type": "object", "additionalProperties": false, "required": ["objectTypes", "links", "interfaces", "invariants", "businessTerms"], "properties": {"objectTypes": {"type": "array", "items": {"$ref": "#/$defs/objectType"}}, "links": {"type": "array", "items": {"$ref": "#/$defs/linkType"}}, "interfaces": {"type": "array", "items": {"$ref": "#/$defs/interface"}}, "invariants": {"type": "array", "items": {"$ref": "#/$defs/rule"}}, "businessTerms": {"type": "array", "items": {"$ref": "#/$defs/businessTerm"}}}},
    "parameter": {"type": "object", "additionalProperties": false, "required": ["id", "label", "valueType"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "valueType": {"$ref": "#/$defs/valueType"}, "required": {"type": "boolean"}}},
    "effect": {"type": "object", "additionalProperties": false, "required": ["targetRef", "operation", "expression"], "properties": {"targetRef": {"$ref": "#/$defs/stableId"}, "operation": {"enum": ["create", "update", "delete", "emit", "transition"]}, "expression": {"type": "string", "minLength": 1}}},
    "stateTransitionContract": {"type": "object", "additionalProperties": false, "required": ["subjectRef", "fromStateRef", "toStateRef"], "properties": {"subjectRef": {"$ref": "#/$defs/stableId"}, "fromStateRef": {"$ref": "#/$defs/stableId"}, "toStateRef": {"$ref": "#/$defs/stableId"}}},
    "action": {"type": "object", "additionalProperties": false, "required": ["id", "label", "parameters", "preconditions", "effects", "stateTransitions"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "descriptions": {"$ref": "#/$defs/descriptions"}, "status": {"$ref": "#/$defs/lifecycle"}, "evidenceRefs": {"$ref": "#/$defs/idRefs"}, "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}}, "preconditions": {"$ref": "#/$defs/stringList"}, "effects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/effect"}}, "stateTransitions": {"type": "array", "items": {"$ref": "#/$defs/stateTransitionContract"}}, "permissionRefs": {"$ref": "#/$defs/idRefs"}, "auditRefs": {"$ref": "#/$defs/idRefs"}, "sideEffectRefs": {"$ref": "#/$defs/idRefs"}, "compensationRefs": {"$ref": "#/$defs/idRefs"}}},
    "query": {"type": "object", "additionalProperties": false, "required": ["id", "label", "parameters", "resultRef", "expression"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "evidenceRefs": {"$ref": "#/$defs/idRefs"}, "parameters": {"type": "array", "items": {"$ref": "#/$defs/parameter"}}, "resultRef": {"$ref": "#/$defs/stableId"}, "expression": {"type": "string", "minLength": 1}}},
    "state": {"type": "object", "additionalProperties": false, "required": ["id", "label"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "terminal": {"type": "boolean"}}},
    "transition": {"type": "object", "additionalProperties": false, "required": ["id", "fromRef", "toRef", "actionRef"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "fromRef": {"$ref": "#/$defs/stableId"}, "toRef": {"$ref": "#/$defs/stableId"}, "actionRef": {"$ref": "#/$defs/stableId"}, "guard": {"type": "string"}}},
    "stateMachine": {"type": "object", "additionalProperties": false, "required": ["id", "label", "targetRef", "subjectRef", "initialStateRef", "states", "transitions"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "targetRef": {"$ref": "#/$defs/stableId"}, "subjectRef": {"$ref": "#/$defs/stableId"}, "initialStateRef": {"$ref": "#/$defs/stableId"}, "states": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/state"}}, "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}}, "evidenceRefs": {"$ref": "#/$defs/idRefs"}}},
    "domainEvent": {"type": "object", "additionalProperties": false, "required": ["id", "label", "subjectRef", "payload"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "subjectRef": {"$ref": "#/$defs/stableId"}, "payload": {"type": "array", "items": {"$ref": "#/$defs/parameter"}}, "evidenceRefs": {"$ref": "#/$defs/idRefs"}}},
    "kinetics": {"type": "object", "additionalProperties": false, "required": ["actions", "queries", "stateMachines", "domainEvents"], "properties": {"actions": {"type": "array", "items": {"$ref": "#/$defs/action"}}, "queries": {"type": "array", "items": {"$ref": "#/$defs/query"}}, "stateMachines": {"type": "array", "items": {"$ref": "#/$defs/stateMachine"}}, "domainEvents": {"type": "array", "items": {"$ref": "#/$defs/domainEvent"}}}},
    "mapping": {"type": "object", "additionalProperties": false, "required": ["ontologyPath", "sourcePath"], "properties": {"ontologyPath": {"type": "string", "minLength": 1}, "sourcePath": {"type": "string", "minLength": 1}, "transform": {"type": "string"}}},
    "dataBinding": {"type": "object", "additionalProperties": false, "required": ["id", "targetRef", "direction", "evidenceRefs", "source", "mappings"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "targetRef": {"$ref": "#/$defs/stableId"}, "direction": {"enum": ["inbound", "outbound", "bidirectional"]}, "evidenceRefs": {"$ref": "#/$defs/nonEmptyIdRefs"}, "source": {"type": "object", "additionalProperties": false, "required": ["system", "resource"], "properties": {"system": {"type": "string", "minLength": 1}, "resource": {"type": "string", "minLength": 1}}}, "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}}}},
    "apiBinding": {"type": "object", "additionalProperties": false, "required": ["id", "targetRef", "direction", "evidenceRefs", "operation", "mappings"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "targetRef": {"$ref": "#/$defs/stableId"}, "direction": {"enum": ["inbound", "outbound", "bidirectional"]}, "evidenceRefs": {"$ref": "#/$defs/nonEmptyIdRefs"}, "operation": {"type": "object", "additionalProperties": false, "required": ["specUri", "operationId"], "properties": {"specUri": {"type": "string", "format": "uri"}, "operationId": {"type": "string", "minLength": 1}}}, "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}}}},
    "codeBinding": {"type": "object", "additionalProperties": false, "required": ["id", "targetRef", "direction", "evidenceRefs", "symbol", "mappings"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "targetRef": {"$ref": "#/$defs/stableId"}, "direction": {"enum": ["inbound", "outbound", "bidirectional"]}, "evidenceRefs": {"$ref": "#/$defs/nonEmptyIdRefs"}, "symbol": {"type": "object", "additionalProperties": false, "required": ["language", "qualifiedName"], "properties": {"language": {"type": "string"}, "qualifiedName": {"type": "string"}}}, "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}}}},
    "eventBinding": {"type": "object", "additionalProperties": false, "required": ["id", "targetRef", "direction", "evidenceRefs", "channel", "mappings"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "targetRef": {"$ref": "#/$defs/stableId"}, "direction": {"enum": ["inbound", "outbound", "bidirectional"]}, "evidenceRefs": {"$ref": "#/$defs/nonEmptyIdRefs"}, "channel": {"type": "object", "additionalProperties": false, "required": ["protocol", "name"], "properties": {"protocol": {"type": "string"}, "name": {"type": "string"}}}, "mappings": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mapping"}}}},
    "operationalPolicy": {"type": "object", "additionalProperties": false, "required": ["id", "label", "targetRefs", "rule"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "targetRefs": {"$ref": "#/$defs/nonEmptyIdRefs"}, "rule": {"type": "string", "minLength": 1}, "evidenceRefs": {"$ref": "#/$defs/idRefs"}}},
    "bindings": {"type": "object", "additionalProperties": false, "required": ["dataBindings", "apiBindings", "codeBindings", "eventBindings", "identityResolution", "syncPolicies", "consistencyPolicies"], "properties": {"dataBindings": {"type": "array", "items": {"$ref": "#/$defs/dataBinding"}}, "apiBindings": {"type": "array", "items": {"$ref": "#/$defs/apiBinding"}}, "codeBindings": {"type": "array", "items": {"$ref": "#/$defs/codeBinding"}}, "eventBindings": {"type": "array", "items": {"$ref": "#/$defs/eventBinding"}}, "identityResolution": {"type": "array", "items": {"$ref": "#/$defs/operationalPolicy"}}, "syncPolicies": {"type": "array", "items": {"$ref": "#/$defs/operationalPolicy"}}, "consistencyPolicies": {"type": "array", "items": {"$ref": "#/$defs/operationalPolicy"}}}},
    "policy": {"type": "object", "additionalProperties": false, "required": ["id", "label", "targetRefs", "rule"], "properties": {"id": {"$ref": "#/$defs/stableId"}, "label": {"$ref": "#/$defs/label"}, "descriptions": {"$ref": "#/$defs/descriptions"}, "status": {"$ref": "#/$defs/lifecycle"}, "evidenceRefs": {"$ref": "#/$defs/idRefs"}, "targetRefs": {"$ref": "#/$defs/nonEmptyIdRefs"}, "rule": {"type": "string", "minLength": 1}, "severity": {"enum": ["info", "warning", "error"]}}},
    "policies": {"type": "object", "additionalProperties": false, "required": ["authorizationPolicies", "auditPolicies", "qualityPolicies", "compliancePolicies"], "properties": {"authorizationPolicies": {"type": "array", "items": {"$ref": "#/$defs/policy"}}, "auditPolicies": {"type": "array", "items": {"$ref": "#/$defs/policy"}}, "qualityPolicies": {"type": "array", "items": {"$ref": "#/$defs/policy"}}, "compliancePolicies": {"type": "array", "items": {"$ref": "#/$defs/policy"}}}},
    "evidenceRecord": {"type": "object", "additionalProperties": false, "required": ["id", "sourceUri", "location", "capturedAt", "contentHash", "extractorVersion", "kind"], "properties": {"id": {"$ref": "#/$defs/internalStableId"}, "sourceUri": {"type": "string", "format": "uri"}, "location": {"type": "string", "minLength": 1}, "capturedAt": {"type": "string", "format": "date-time"}, "contentHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "extractorVersion": {"type": "string", "minLength": 1}, "kind": {"enum": ["document", "database", "api", "code", "event", "interview", "observation"]}}},
    "confidenceRationaleItem": {"type": "object", "additionalProperties": false, "required": ["score", "rationale", "evidenceRefs", "deductions"], "properties": {"score": {"type": "integer", "minimum": 0, "maximum": 100}, "rationale": {"type": "string", "minLength": 1}, "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/internalStableId"}}, "deductions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "confidenceRationale": {"type": "object", "additionalProperties": false, "required": ["crossSourceAgreement", "evidenceCoverage", "runtimeSupport", "semanticSpecificity", "constraintConsistency", "counterEvidenceAssessment"], "properties": {"crossSourceAgreement": {"$ref": "#/$defs/confidenceRationaleItem"}, "evidenceCoverage": {"$ref": "#/$defs/confidenceRationaleItem"}, "runtimeSupport": {"$ref": "#/$defs/confidenceRationaleItem"}, "semanticSpecificity": {"$ref": "#/$defs/confidenceRationaleItem"}, "constraintConsistency": {"$ref": "#/$defs/confidenceRationaleItem"}, "counterEvidenceAssessment": {"$ref": "#/$defs/confidenceRationaleItem"}}},
    "discoveryClaim": {"type": "object", "additionalProperties": false, "required": ["id", "label", "statement", "status", "reasoningRules", "evidenceRefs", "counterEvidenceRefs", "counterEvidenceLevel", "counterEvidenceAssessment", "alternatives", "confidenceDimensions", "confidenceRationale", "confidence", "grade", "falsifiers", "validationQuestions", "capabilityQuestions", "provenance"], "properties": {"id": {"$ref": "#/$defs/internalStableId"}, "label": {"$ref": "#/$defs/label"}, "statement": {"type": "string", "minLength": 1}, "status": {"$ref": "#/$defs/lifecycle"}, "reasoningRules": {"type": "array", "minItems": 1, "items": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "additionalProperties": false, "required": ["ruleId", "explanation"], "properties": {"ruleId": {"$ref": "#/$defs/stableId"}, "explanation": {"type": "string", "minLength": 1}}}]}}, "evidenceRefs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/internalStableId"}}, "counterEvidenceRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/internalStableId"}}, "counterEvidenceLevel": {"enum": ["none", "minor", "material", "strong", "coreContradiction"]}, "counterEvidenceAssessment": {"type": "string", "minLength": 1}, "alternatives": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "confidenceDimensions": {"type": "object", "additionalProperties": false, "required": ["crossSourceAgreement", "evidenceCoverage", "runtimeSupport", "semanticSpecificity", "constraintConsistency", "counterEvidenceAssessment"], "properties": {"crossSourceAgreement": {"type": "integer", "minimum": 0, "maximum": 100}, "evidenceCoverage": {"type": "integer", "minimum": 0, "maximum": 100}, "runtimeSupport": {"type": "integer", "minimum": 0, "maximum": 100}, "semanticSpecificity": {"type": "integer", "minimum": 0, "maximum": 100}, "constraintConsistency": {"type": "integer", "minimum": 0, "maximum": 100}, "counterEvidenceAssessment": {"type": "integer", "minimum": 0, "maximum": 100}}}, "confidenceRationale": {"$ref": "#/$defs/confidenceRationale"}, "confidence": {"type": "integer", "minimum": 0, "maximum": 100}, "grade": {"enum": ["A", "B", "C", "D"]}, "falsifiers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "validationQuestions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "capabilityQuestions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "provenance": {"type": "object", "additionalProperties": false, "required": ["extractorVersion", "ruleSetVersion", "generatedAt"], "properties": {"extractorVersion": {"type": "string", "minLength": 1}, "ruleSetVersion": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}, "generatedAt": {"type": "string", "format": "date-time"}}}}},
    "evidenceObservation": {"type": "object", "additionalProperties": false, "required": ["id", "kind", "sourceUri", "location", "capturedAt", "contentHash", "extractorVersion", "observedFacts"], "properties": {"id": {"$ref": "#/$defs/internalStableId"}, "kind": {"enum": ["database", "openapi", "code", "config", "eventLog"]}, "sourceUri": {"type": "string", "format": "uri"}, "location": {"type": "string", "minLength": 1}, "capturedAt": {"type": "string", "format": "date-time"}, "contentHash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "extractorVersion": {"type": "string", "minLength": 1}, "observedFacts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "evidenceGraph": {"type": "object", "additionalProperties": false, "required": ["ontologyId", "generatedAt", "observations"], "properties": {"ontologyId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"}, "generatedAt": {"type": "string", "format": "date-time"}, "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidenceObservation"}}}},
    "discoveryClaimsDocument": {"type": "object", "additionalProperties": false, "required": ["ontologyId", "generatedAt", "claims"], "properties": {"ontologyId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$"}, "generatedAt": {"type": "string", "format": "date-time"}, "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/discoveryClaim"}}}},
    "adjudicationDecision": {"type": "object", "additionalProperties": false, "required": ["claimRef", "outcome", "rationale", "evidenceRefs", "conditions", "actions"], "properties": {"claimRef": {"$ref": "#/$defs/internalStableId"}, "outcome": {"enum": ["accepted", "needsRevision", "rejected", "deferred"]}, "rationale": {"type": "string", "minLength": 1}, "evidenceRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/internalStableId"}}, "resultingElementRefs": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/internalStableId"}}, "conditions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "actions": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
